# Copy to .env.mainnet (gitignored) on the machine that deploys. Read by scripts/mainnet.mjs, keeper.mjs and
# smoke-mainnet.mjs. Inline comments after a value are allowed; quotes are optional.

# ---- signing: a keystore, made once with `cast wallet import halve --interactive` (paste the key when asked)
#      and a password file: umask 077; printf %s 'your-password' > /root/.halve.pass
WALLET_ARGS=--account halve --password-file /root/.halve.pass
# WALLET_ARGS=--ledger
# DEPLOYER_KEY=0x…   (refused against a remote chain: it would sit on the command line for every process to read)

# ---- chain
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
# verify sources on Blockscout after deploying (best effort; never blocks the deployment)
VERIFY=1
# ETH the deployer must hold before the run starts
MIN_GAS_ETH=0.02

# ---- the series
# STOCK: leave empty and it is resolved from TICKER through Robinhood's asset registry, verified on-chain and
# pinned here. TICKER must match a `ticker` in src/contracts/series.json (SGOV, SCHD, SPY, AAPL, NVDA, MSFT,
# AMZN, GOOGL, META, TSLA); SERIES_ID picks one when the same ticker has several series.
STOCK=
TICKER=SPY
# SERIES_ID=SPY-MAR27
# unix timestamp of the maturity, e.g. 1806451200 = 2027-03-31 00:00 UTC
MATURITY=1806451200
# raw units: 1e18 = 1 share for an 18-decimal token (here 1,000,000 shares)
CAP=1000000000000000000000000
# receives the 0.10 % split fee and the 5 % yield fee
TREASURY=
# resolves held corporate actions after the 2-day timelock; must be able to act within days
GUARDIAN=
# can only change cap and treasury
OWNER=
# Chainlink stock/USD feed on 4663 (optional: without it USD values come from the market feed)
PRICE_FEED=
# reuse an accountant already deployed for this stock token (filled in automatically from series.json)
# ACCOUNTANT=

# ---- pools (Uniswap v3 on Robinhood Chain)
# NonfungiblePositionManager (@uniswap/sdk-core); empty = deploy without pools (the app keeps the series in demo mode)
NPM=0x73991a25c818bf1f1128deaab1492d45638de0d3
# 0.30 % pool fee tier; pools are PT/stock and YT/stock (raw units never rebase)
FEE=3000
# 0.96 stock per PT and 0.04 stock per YT (WAD); they must add up to one share
PT_PRICE=960000000000000000
YT_PRICE=40000000000000000
# stock (raw units) to split for seeding; the deployer needs about 2× this. Leave unset to create empty pools.
# SEED_AMOUNT=10000000000000000000000
