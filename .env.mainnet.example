# Copy to .env.mainnet (gitignored) on the machine that deploys. Read by scripts/mainnet.mjs.

# ---- signing: exactly one of these ----
DEPLOYER_KEY=                     # 0x… private key of a funded deployer (needs ETH on Robinhood Chain for gas)
# WALLET_ARGS=--account halve --password-file ~/.halve.pass   # a keystore made with `cast wallet import halve --interactive`
# WALLET_ARGS=--ledger

# ---- chain ----
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
VERIFY=1                          # verify sources on Blockscout after deploying

# ---- the series ----
STOCK=                            # ERC-8056 stock token address (must answer uiMultiplier())
TICKER=JEPI                       # must match a `ticker` in src/contracts/series.json
# SERIES_ID=JEPI-MAR27            # when the same ticker has several series
MATURITY=1806451200               # unix timestamp
CAP=1000000000000000000000000     # base units, 1e18 = 1 share (here 1,000,000)
TREASURY=                         # receives the 0.10 % split fee and the 5 % yield fee
GUARDIAN=                         # resolves held corporate actions after the 2-day timelock
OWNER=                            # can only change cap and treasury
PRICE_FEED=                       # Chainlink stock/USD feed on 4663 (optional; USD shows $0 without it)
# ACCOUNTANT=                     # reuse an accountant already deployed for this stock token

# ---- pools (Uniswap v3 on Robinhood Chain) ----
NPM=                              # NonfungiblePositionManager address; leave empty to skip pools
QUOTE_KIND=wrapped                # wrapped (wStock, recommended) or stock (rebasing: not supported by Uniswap v3)
# WSTOCK=                         # reuse an existing WrappedStock for this stock token
FEE=3000                          # 0.30 % pool fee tier
PT_PRICE=960000000000000000       # 0.96 wStock per PT (WAD)
YT_PRICE=40000000000000000        # 0.04 wStock per YT (WAD)
# SEED_AMOUNT=10000000000000000000000   # stock (18 dec) to split AND to wrap for seeding; deployer needs 2× this
