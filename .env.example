# ---- Halve frontend ----

# Mock mode: render the prototype's numbers instead of reading chain 4663.
# Defaults to true. Set to false once src/contracts/series.json has real addresses.
# (Series that still have 0x000… addresses stay mocked even when this is false.)
# In mock mode the wallet picker also offers a "Demo wallet" backed by wagmi's mock connector.
MOCK=true

# Live market prices (server-side fetch from Yahoo Finance, Stooq as the price fallback, cached 60 s):
# demo series show the real share price, trailing dividend yield and 30-day chart with indicative PT / YT
# prices until the pools exist, and a live series without a Chainlink feed prices USD from it.
# Set to false to keep the prototype's demo numbers everywhere (the test suites do), or to `fixture` for
# deterministic quotes built from the demo table (the preview UI without network access).
LIVE_MARKET=true

# WalletConnect Cloud project id (https://cloud.reown.com).
# The WalletConnect option is hidden until this is set; MetaMask and Rabby work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: override the Robinhood Chain RPC (default: https://rpc.mainnet.chain.robinhood.com).
NEXT_PUBLIC_RPC_URL=

# Optional: average block time in ms; sizes the swap-log window used as the chart fallback (default 100).
NEXT_PUBLIC_BLOCK_TIME_MS=100

# Canonical site URL for metadata / OG image. Defaults to https://halve.finance (Vercel previews use their own URL).
NEXT_PUBLIC_SITE_URL=

# ---- YT price / TVL history (server only) ----
# Vercel KV or Upstash Redis REST credentials. Either pair works. Without them the chart
# falls back to Uniswap Swap events (30d → 7d → 1d) and the 24h / 7d change labels stay empty.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Protects /api/cron/sample (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# ---- Lend (optional) ----
# Morpho Blue singleton on chain 4663. With this set and a `morphoMarketId` per series in
# series.json, /lend reads supplied / borrowed / LLTV live instead of deriving them from TVL.
NEXT_PUBLIC_MORPHO_BLUE=

# ---- Links (optional, fall back to "#") ----
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_CONTRACTS_URL=
NEXT_PUBLIC_AUDIT_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_DISCORD_URL=

# ---- Access (server only) ----
# Countries (ISO alpha-2, comma separated) whose requests to /app and /lend are redirected to /restricted
# when the edge in front of the app sets a country header (Cloudflare, Vercel, GeoIP module). Default: US.
BLOCKED_COUNTRIES=US

# ---- Monitoring (optional) ----
# Reported by /api/health as `commit` (set by your deploy script, e.g. GIT_SHA=$(git rev-parse --short HEAD)).
GIT_SHA=
# Client-side errors (route + global error boundaries) are POSTed here as JSON when set.
NEXT_PUBLIC_ERROR_ENDPOINT=
